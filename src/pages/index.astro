---
import Base from '../layouts/Base.astro';
import Forecast from '../components/Forecast.astro';
---

<Base>
  <section class="hero">
    <p class="eyebrow">Picos de Europa</p>
    <h1>El tiempo en los tres macizos</h1>
    <p class="muted lead">
      Previsión por zonas y altitudes, mapas interactivos y boletines para planificar tus salidas
      a la montaña.
    </p>
  </section>

  <Forecast />
</Base>

<style>
  .hero {
    padding: 40px 0 24px;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }
  h1 {
    margin: 4px 0 12px;
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    line-height: 1.15;
  }
  .lead {
    max-width: 55ch;
    margin: 0;
  }
</style>
