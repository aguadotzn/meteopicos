---
import Base from '../layouts/Base.astro';
import Forecast from '../components/Forecast.astro';
---

<Base title="Previsión" description="Previsión a 6 días por macizos, valles y cumbres de los Picos de Europa, con isoterma de 0 °C.">
  <header class="page-head">
    <p class="eyebrow">Previsión</p>
    <h1>Seis días por zonas y altitudes</h1>
    <p class="muted lead">
      Temperatura, precipitación, nieve y viento en valles, refugios y cumbres de los tres macizos.
    </p>
  </header>

  <Forecast />
</Base>

<style>
  .page-head {
    padding: 32px 0 20px;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }
  h1 {
    margin: 4px 0 10px;
    font-size: clamp(1.7rem, 5.5vw, 2.4rem);
    line-height: 1.15;
  }
  .lead {
    max-width: 60ch;
    margin: 0;
  }
</style>
