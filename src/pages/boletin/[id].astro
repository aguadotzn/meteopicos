---
import Base from '../../layouts/Base.astro';
import BulletinArticle from '../../components/BulletinArticle.astro';
import { getBulletins } from '../../lib/bulletins';

export async function getStaticPaths() {
  const bulletins = await getBulletins();
  return bulletins.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`Boletín nº ${entry.data.number}`} description={entry.data.summary}>
  <p class="back"><a href={`${base}/boletin`}>← Último boletín</a></p>
  <BulletinArticle entry={entry} />
</Base>

<style>
  .back {
    margin: 20px 0 0;
    font-size: 0.9rem;
  }
</style>
