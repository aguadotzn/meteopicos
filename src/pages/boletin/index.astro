---
import Base from '../../layouts/Base.astro';
import BulletinArticle from '../../components/BulletinArticle.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import { getBulletins, longDate } from '../../lib/bulletins';

const [latest, ...older] = await getBulletins();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Boletín" description="Boletín del tiempo en los Picos de Europa y archivo de boletines anteriores.">
  {
    latest ? (
      <>
        <BulletinArticle entry={latest} />
        {older.length > 0 && (
          <section class="archive" aria-labelledby="archivo">
            <h2 id="archivo">Boletines anteriores</h2>
            <ul>
              {older.map((b) => (
                <li>
                  <a href={`${base}/boletin/${b.id}`}>
                    <span class="n">nº {b.data.number}</span>
                    <span class="t">{b.data.title}</span>
                    <span class="d muted">{longDate.format(b.data.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    ) : (
      <ComingSoon title="Boletín" text="Todavía no hay boletines publicados." />
    )
  }
</Base>

<style>
  .archive {
    margin-top: 40px;
  }
  h2 {
    font-size: 1.1rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 10px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .n {
    color: var(--accent);
    font-weight: 700;
  }
  .d {
    grid-column: 2;
    font-size: 0.85rem;
  }
</style>
