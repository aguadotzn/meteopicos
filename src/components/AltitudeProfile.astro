---
// Portada: perfil de los macizos con la isoterma de 0 °C y la temperatura por alturas.
// La silueta es esquemática pero sus cimas están a su altitud real.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const W = 400;
const H = 270;
const TOP = 26;
const BOTTOM = 252;
const MAX_ALT = 2800;
const y = (alt: number) => BOTTOM - (alt / MAX_ALT) * (BOTTOM - TOP);

// [x, altitud]: Cornión, río Cares, Urrieles, río Duje, Ándara y descenso a los valles.
const profile: [number, number][] = [
  [0, 420], [12, 650], [24, 1100], [36, 1600], [46, 1950], [54, 2300], [62, 2596], [70, 2380],
  [78, 2200], [86, 1700], [94, 900], [100, 560],
  [108, 1100], [116, 1700], [126, 2200], [136, 2649], [144, 2450], [152, 2380], [158, 2518],
  [166, 2350], [174, 2450], [182, 2614], [190, 2300], [198, 1800], [206, 1200], [212, 950],
  [220, 1400], [228, 1950], [236, 2444], [246, 2150], [256, 1700], [266, 1150], [280, 700],
  [300, 450], [330, 340], [400, 300],
];
const ridge = profile.map(([x, a]) => `${x},${y(a).toFixed(1)}`).join(' L');
const silhouette = `M0,${H} L${ridge} L${W},${H} Z`;

const peaks = [
  { name: 'Peña Santa', x: 62, alt: 2596 },
  { name: 'Torre Cerredo', x: 136, alt: 2649 },
  { name: 'Lechugales', x: 232, alt: 2444 },
];

// Bandas de altitud con su etiqueta; la cota media se recalcula en el cliente.
const bands = [
  { level: 'cumbre', label: 'Cumbres', alt: 2560 },
  { level: 'alta', label: 'Alta montaña', alt: 1750 },
  { level: 'media', label: 'Media montaña', alt: 1020 },
  { level: 'valle', label: 'Valles', alt: 350 },
];
const isoDefault = 2000;
---

<section class="profile" aria-labelledby="p-title" data-profile data-max-alt={MAX_ALT} data-top={TOP} data-bottom={BOTTOM}>
  <div class="head">
    <p class="eyebrow" data-date>Picos de Europa</p>
    <h1 id="p-title">Así está la montaña, por alturas</h1>
    <p class="summary" data-summary aria-live="polite">Cargando la previsión…</p>
  </div>

  <figure class="figure">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="p-desc" data-svg>
      <desc id="p-desc" data-desc>Perfil de los tres macizos con la isoterma de 0 °C y la temperatura por altitudes.</desc>
      <defs>
        <clipPath id="ridge-clip"><path d={silhouette} /></clipPath>
      </defs>
      <path d={silhouette} class="rock" />
      <g clip-path="url(#ridge-clip)">
        <rect x="0" y="0" width={W} height={y(isoDefault)} class="frost" data-frost />
      </g>
      <path d={`M${ridge}`} class="ridge" />

      {peaks.map((p) => (
        <text x={p.x} y={y(p.alt) - 7} class="peak-name" text-anchor="middle">{p.name}</text>
      ))}

      <g class="iso" data-iso style={`transform: translateY(${y(isoDefault)}px)`}>
        <line x1="0" x2={W} y1="0" y2="0" />
        <text x="4" y="-6" data-iso-label>0 °C</text>
      </g>

      {bands.map((b) => (
        <g class="band" data-band={b.level} style={`transform: translateY(${y(b.alt)}px)`}>
          <line x1="270" x2="296" y1="0" y2="0" />
          <text x="396" y="-6" class="band-label" text-anchor="end" data-band-label>{b.label}</text>
          <text x="396" y="12" class="band-temp" text-anchor="end" data-band-temp>—</text>
        </g>
      ))}
    </svg>
    <figcaption class="muted">Perfil esquemático · cimas a su altitud real · Open-Meteo</figcaption>
  </figure>

  <div class="days" role="group" aria-label="Elegir día" data-days>
    {[0, 1, 2].map((i) => (
      <button type="button" class="day" data-day={i} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="wd">{i === 0 ? 'Hoy' : '—'}</span>
        <span class="ic" aria-hidden="true">·</span>
        <span class="t">—</span>
        <span class="iso0">0 °C a —</span>
      </button>
    ))}
  </div>

  <a class="cta" href={`${base}/prevision`}>Ver previsión por zonas <span aria-hidden="true">→</span></a>
</section>

<script>
  import { points, type Level } from '../data/zones';
  import { getForecast, summarize, type Day } from '../lib/forecast';
  import { wmo } from '../lib/wmo';

  const root = document.querySelector<HTMLElement>('[data-profile]')!;
  const MAX_ALT = Number(root.dataset.maxAlt);
  const TOP = Number(root.dataset.top);
  const BOTTOM = Number(root.dataset.bottom);
  const y = (alt: number) => BOTTOM - (Math.min(alt, MAX_ALT) / MAX_ALT) * (BOTTOM - TOP);

  const m = new Intl.NumberFormat('es-ES', { useGrouping: 'always', maximumFractionDigits: 0 });
  const weekday = new Intl.DateTimeFormat('es-ES', { weekday: 'short', timeZone: 'UTC' });
  const longDate = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
  const r = Math.round;
  const asDate = (iso: string) => new Date(`${iso}T12:00:00Z`);
  const meters = (v: number | null) => (v == null ? '—' : `${m.format(r(v / 100) * 100)} m`);
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  const levels: Level[] = ['cumbre', 'alta', 'media', 'valle'];
  const $ = <T extends Element>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;

  interface Group {
    level: Level;
    altitude: number;
    days: Day[];
  }

  function summary(g: Record<Level, Group>, j: number, freezing: number | null) {
    const top = g.cumbre.days[j];
    const valley = g.valle.days[j];
    const iso = meters(freezing);
    const parts: string[] = [];
    if (top.snow >= 0.5) parts.push(`Nieve en cumbres (${r(top.snow)} cm) con la isoterma de 0 °C en torno a ${iso}.`);
    else if (Math.max(top.precipProb, g.alta.days[j].precipProb) >= 50) parts.push(`Precipitación probable en altura (${Math.max(top.precipProb, g.alta.days[j].precipProb)} %).`);
    else if (valley.precipProb >= 50) parts.push(`Lluvia probable en los valles (${valley.precipProb} %).`);
    else parts.push(`${wmo(valley.code).label} en los valles; 0 °C en torno a ${iso}.`);
    if (top.gust >= 60) parts.push(`Rachas de ${r(top.gust)} km/h en crestas.`);
    return parts.join(' ');
  }

  async function init() {
    try {
      const forecast = await getForecast(points);
      const groups = Object.fromEntries(
        levels.map((level) => {
          const pf = forecast.points.filter((p) => p.point.level === level);
          const altitude = pf.reduce((a, p) => a + p.point.altitude, 0) / pf.length;
          // Media del grupo: más representativa de una franja de altitud que el peor caso.
          const days = pf[0].days.map((_, j) => {
            const ds = pf.map((p) => p.days[j]);
            const avg = (k: keyof Day) => ds.reduce((a, d) => a + (d[k] as number), 0) / ds.length;
            return {
              ...ds[0],
              code: Math.max(...ds.map((d) => d.code)),
              tMax: avg('tMax'),
              tMin: avg('tMin'),
              precipProb: Math.max(...ds.map((d) => d.precipProb)),
              snow: Math.max(...ds.map((d) => d.snow)),
              gust: Math.max(...ds.map((d) => d.gust)),
            };
          });
          return [level, { level, altitude, days }];
        }),
      ) as Record<Level, Group>;
      const all = summarize(forecast.points);

      // Las bandas se colocan a la altitud media real de sus puntos.
      for (const g of Object.values(groups)) {
        const band = $<SVGGElement>(`[data-band="${g.level}"]`);
        band.style.transform = `translateY(${y(g.altitude)}px)`;
        const label = $<SVGTextElement>('[data-band-label]', band);
        label.textContent = `${label.textContent} · ${m.format(r(g.altitude / 10) * 10)} m`;
      }

      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-day]')];
      buttons.forEach((b, j) => {
        const d = all[j];
        const v = groups.valle.days[j];
        const w = wmo(v.code);
        $('.wd', b).textContent = j === 0 ? 'Hoy' : cap(weekday.format(asDate(d.date)));
        $('.ic', b).textContent = w.icon;
        $('.ic', b).setAttribute('title', w.label);
        $('.t', b).innerHTML = `<b>${r(v.tMax)}°</b>/${r(v.tMin)}° <small>valles</small>`;
        $('.iso0', b).textContent = `0 °C a ${meters(d.freezingLevel)}`;
        b.addEventListener('click', () => show(j));
      });

      function show(j: number) {
        buttons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === j)));
        const d = all[j];
        const iso = d.freezingLevel ?? MAX_ALT;
        $<SVGGElement>('[data-iso]').style.transform = `translateY(${y(iso)}px)`;
        $<SVGRectElement>('[data-frost]').setAttribute('height', String(y(iso)));
        $('[data-iso-label]').textContent = `0 °C · ${meters(d.freezingLevel)}`;
        for (const g of Object.values(groups)) {
          const day = g.days[j];
          $(`[data-band="${g.level}"] [data-band-temp]`).textContent = `${wmo(day.code).icon} ${r(day.tMax)}° / ${r(day.tMin)}°`;
        }
        $('[data-date]').textContent = cap(longDate.format(asDate(d.date)));
        $('[data-summary]').textContent = summary(groups, j, d.freezingLevel);
        $('[data-desc]').textContent =
          `${cap(longDate.format(asDate(d.date)))}: isoterma de 0 °C a ${meters(d.freezingLevel)}. ` +
          levels.map((l) => `${l}: ${r(groups[l].days[j].tMax)}° de máxima`).join(', ') + '.';
      }

      show(0);
    } catch (err) {
      console.error(err);
      $('[data-summary]').innerHTML =
        'No se ha podido cargar la previsión. Consulta <a href="https://www.aemet.es/es/eltiempo/prediccion/montana?w=&p=peu1">AEMET montaña</a>.';
    }
  }

  init();
</script>

<style>
  .profile {
    display: grid;
    gap: 16px;
    padding: 28px 0 8px;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }
  h1 {
    margin: 4px 0 8px;
    font-size: clamp(1.9rem, 7vw, 3rem);
    line-height: 1.08;
    max-width: 18ch;
  }
  .summary {
    margin: 0;
    font-size: 1.05rem;
    max-width: 52ch;
    min-height: 3em;
  }

  .figure {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .rock {
    fill: var(--rock);
  }
  .frost {
    fill: var(--frost);
    transition: height 0.6s ease;
  }
  .ridge {
    fill: none;
    stroke: var(--rock-dark);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .peak-name {
    fill: var(--muted);
    font: 500 9.5px var(--font);
  }
  .iso {
    transition: transform 0.6s ease;
  }
  .iso line {
    stroke: var(--sky);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }
  .iso text {
    fill: var(--sky);
    font: 600 12px var(--font);
  }
  .band line {
    stroke: var(--muted);
    stroke-width: 1;
  }
  /* Halo del color de fondo: la isoterma y la roca no tachan las etiquetas */
  .band-label,
  .band-temp,
  .iso text {
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .band-label {
    fill: var(--muted);
    font: 500 10.5px var(--font);
  }
  .band-temp {
    fill: var(--text);
    font: 700 15px var(--font);
  }
  figcaption {
    font-size: 0.75rem;
    margin-top: 4px;
  }

  .days {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .day {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 10px 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .day[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .day .wd {
    font-weight: 700;
  }
  .day .ic {
    font-size: 1.5rem;
    line-height: 1.3;
  }
  .day :global(small),
  .day .iso0 {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .day .iso0 {
    color: var(--sky);
  }

  .cta {
    justify-self: start;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .cta:hover {
    filter: brightness(1.08);
  }

  @media (min-width: 900px) {
    .profile {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        'head figure'
        'days figure'
        'cta figure';
      align-items: start;
      column-gap: 40px;
      padding-top: 48px;
    }
    .head {
      grid-area: head;
    }
    .figure {
      grid-area: figure;
    }
    .days {
      grid-area: days;
    }
    .cta {
      grid-area: cta;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frost,
    .iso {
      transition: none;
    }
  }
</style>
