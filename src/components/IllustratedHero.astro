---
// Portada ilustrada: montañas geométricas cuyo cielo cambia con el tiempo, la línea de
// «hiela por encima de…» a su altura real, una frase en lenguaje llano y cuatro claves.
// Las cimas de la silueta están a su altitud real (Peña Santa, Torre Cerredo, Lechugales…).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const W = 400;
const H = 260;
const TOP = 34;
const BOTTOM = 236;
const MAX_ALT = 2800;
const y = (alt: number) => BOTTOM - (alt / MAX_ALT) * (BOTTOM - TOP);

// [x, altitud]: Cornión, río Cares, Urrieles, río Duje, Ándara y descenso a los valles.
const profile: [number, number][] = [
  [0, 500], [20, 900], [44, 1700], [62, 2300], [76, 2596], [92, 2150], [108, 1300], [120, 700],
  [136, 1500], [154, 2250], [170, 2649], [184, 2380], [196, 2518], [210, 2300], [224, 2614],
  [242, 2000], [258, 1100], [272, 1500], [292, 2444], [312, 1900], [332, 1200], [356, 750],
  [380, 560], [400, 480],
];
const ridge = profile.map(([x, a]) => `${x},${y(a).toFixed(1)}`).join(' L');
const mountains = `M0,${H} L${ridge} L${W},${H} Z`;
const isoDefault = 2000;
---

<section class="hero" data-hero data-sky="clear" data-max-alt={MAX_ALT} data-top={TOP} data-bottom={BOTTOM} aria-labelledby="h-title">
  <figure class="art">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="h-desc">
      <desc id="h-desc" data-desc>Ilustración de los Picos de Europa con el tiempo de hoy.</desc>
      <defs>
        <clipPath id="mtn-clip"><path d={mountains} /></clipPath>
      </defs>
      <rect width={W} height={H} class="sky-bg" />

      <!-- Astros y cielo: se muestran u ocultan según data-sky -->
      <circle class="sun" cx="356" cy="46" r="24" />
      <g class="moon">
        <path d="M352 24 a22 22 0 1 0 19 34 a18 18 0 1 1 -19 -34 Z" />
        <circle cx="60" cy="36" r="1.8" /><circle cx="140" cy="22" r="1.4" /><circle cx="214" cy="40" r="1.8" />
        <circle cx="260" cy="18" r="1.4" /><circle cx="30" cy="80" r="1.4" /><circle cx="380" cy="120" r="1.6" />
      </g>
      <g class="cloud">
        <!-- Escaladas y subidas para quedar en el cielo, por encima de las cimas -->
        <path transform="translate(60 -30) scale(0.75)" d="M232 70 a20 20 0 0 1 36 -10 a16 16 0 0 1 26 12 a13 13 0 0 1 -4 25 h-56 a14 14 0 0 1 -2 -27 Z" />
        <path class="cloud-2" transform="translate(40 -28) scale(0.8)" d="M70 54 a14 14 0 0 1 26 -6 a11 11 0 0 1 16 10 a9 9 0 0 1 -3 17 h-38 a10 10 0 0 1 -1 -21 Z" />
      </g>
      <g class="rain">
        {Array.from({ length: 22 }, (_, i) => (
          <line x1={14 + i * 18} y1={104 + (i % 3) * 22} x2={8 + i * 18} y2={118 + (i % 3) * 22} />
        ))}
      </g>
      <g class="flakes">
        {Array.from({ length: 26 }, (_, i) => (
          <circle cx={10 + ((i * 47) % 390)} cy={18 + ((i * 29) % 120)} r={i % 2 ? 2 : 2.6} />
        ))}
      </g>
      <path class="bolt" transform="translate(0 -50)" d="M262 96 L252 124 L262 124 L254 150 L276 116 L265 116 L272 96 Z" />
      <g class="fog">
        <rect x="0" y="96" width={W} height="10" rx="5" />
        <rect x="30" y="118" width="330" height="8" rx="4" />
        <rect x="0" y="138" width="280" height="8" rx="4" />
      </g>

      <path d={mountains} class="mtn" />
      <!-- Neveros: la montaña por encima de la línea de helada -->
      <g clip-path="url(#mtn-clip)">
        <rect x="0" y="0" width={W} height={y(isoDefault)} class="caps" data-caps />
      </g>

      <g class="iso" data-iso style={`transform: translateY(${y(isoDefault)}px)`}>
        <line x1="0" x2={W} y1="0" y2="0" />
        <rect x="6" y="-21" width="150" height="16" rx="3" class="pill" data-iso-pill />
        <text x="12" y="-9.5" data-iso-label>hiela por encima de —</text>
      </g>

      <path d="M0 260 L0 226 L60 214 L120 230 L180 216 L240 232 L300 218 L360 230 L400 222 L400 260 Z" class="front" />
    </svg>
  </figure>

  <div class="side">
    <h1 id="h-title" class="kicker"><span data-date>Hoy</span> · Picos de Europa</h1>
    <p class="phrase" data-phrase aria-live="polite">Cargando la previsión…</p>

    <dl class="keys">
      <div class="key k-valley"><dt data-k-valley-label>Valles · ahora</dt><dd data-k-valley>—</dd></div>
      <div class="key k-summit"><dt>Cumbres · máx.</dt><dd data-k-summit>—</dd></div>
      <div class="key k-iso"><dt>Hiela desde</dt><dd data-k-iso>—</dd></div>
      <div class="key k-extra"><dt data-k-extra-label>Viento en crestas</dt><dd data-k-extra>—</dd></div>
    </dl>

    <div class="days" role="group" aria-label="Elegir día" data-days>
      {[0, 1, 2].map((i) => (
        <button type="button" data-day={i} aria-pressed={i === 0 ? 'true' : 'false'}>{i === 0 ? 'Hoy' : '—'}</button>
      ))}
    </div>

    <a class="cta" href={`${base}/prevision`}>Ver previsión por zonas <span aria-hidden="true">→</span></a>
    <p class="credit">Ilustración esquemática con las cimas a su altitud real · Datos de Open-Meteo<span data-data-time></span></p>
  </div>
</section>

<script>
  import { points, type Level } from '../data/zones';
  import { getForecast, summarize, type Current, type Day } from '../lib/forecast';
  import { wmo } from '../lib/wmo';
  import { skyFor } from '../lib/sky';

  const root = document.querySelector<HTMLElement>('[data-hero]')!;
  const MAX_ALT = Number(root.dataset.maxAlt);
  const TOP = Number(root.dataset.top);
  const BOTTOM = Number(root.dataset.bottom);
  const y = (alt: number) => BOTTOM - (Math.min(alt, MAX_ALT) / MAX_ALT) * (BOTTOM - TOP);

  const m = new Intl.NumberFormat('es-ES', { useGrouping: 'always', maximumFractionDigits: 0 });
  const weekdayLong = new Intl.DateTimeFormat('es-ES', { weekday: 'long', timeZone: 'UTC' });
  const longDate = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
  const r = Math.round;
  const asDate = (iso: string) => new Date(`${iso}T12:00:00Z`);
  const meters = (v: number | null) => (v == null ? '—' : `${m.format(r(v / 100) * 100)} m`);
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const avg = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;
  const deg = (v: number) => `${r(v)}°`.replace('-', '−');

  const levels: Level[] = ['cumbre', 'alta', 'media', 'valle'];
  const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;

  // Umbrales de la frase y de la cuarta clave
  const SNOW_CM = 1;
  const PRECIP_PROB = 50;
  const GUST_KMH = 50;

  // Frase del día en dos partes: los valles y las cumbres. Describe, no recomienda.
  function phrase(valleyCode: number, top: Day, highProb: number) {
    const valley = `${wmo(valleyCode).label} en los valles.`;
    let summit: string;
    if (top.snow >= SNOW_CM) summit = 'Nieve en las cumbres.';
    else if (highProb >= PRECIP_PROB) summit = 'Posibles precipitaciones en altura.';
    else if (top.tMax <= 0 && top.gust >= GUST_KMH) summit = 'Frío y viento en las cumbres.';
    else if (top.tMax <= 0) summit = 'Frío en las cumbres.';
    else if (top.gust >= GUST_KMH) summit = 'Viento en las cumbres.';
    else summit = 'Buen tiempo también en altura.';
    return `${valley} ${summit}`;
  }

  async function init() {
    try {
      const forecast = await getForecast(points);
      // Media por franja de altitud; precipitación, nieve y rachas con el valor más alto.
      const groups = Object.fromEntries(
        levels.map((level) => {
          const pf = forecast.points.filter((p) => p.point.level === level);
          const days = pf[0].days.map((_, j) => {
            const ds = pf.map((p) => p.days[j]);
            return {
              ...ds[0],
              code: Math.max(...ds.map((d) => d.code)),
              tMax: avg(ds.map((d) => d.tMax)),
              tMin: avg(ds.map((d) => d.tMin)),
              precipProb: Math.max(...ds.map((d) => d.precipProb)),
              snow: Math.max(...ds.map((d) => d.snow)),
              gust: Math.max(...ds.map((d) => d.gust)),
            };
          });
          return [level, days];
        }),
      ) as Record<Level, Day[]>;
      const all = summarize(forecast.points);

      // Ahora mismo en los valles: temperatura media y el tiempo más frecuente.
      const now = forecast.points
        .filter((p) => p.point.level === 'valle')
        .map((p) => p.current)
        .filter((c): c is Current => c != null);
      const nowTemp = now.length ? avg(now.map((c) => c.temp)) : null;
      const codes = now.map((c) => c.code);
      const nowCode = codes.length
        ? [...codes].sort((a, b) => codes.filter((c) => c === b).length - codes.filter((c) => c === a).length)[0]
        : groups.valle[0].code;
      const isDay = now.length ? now.filter((c) => c.isDay).length >= now.length / 2 : true;
      // Hora de los datos actuales (Open-Meteo la da en hora local de Madrid)
      if (now.length) $('[data-data-time]').textContent = `. Datos para las ${now[0].time.slice(11, 16)}`;

      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-day]')];
      buttons.forEach((b, j) => {
        if (j > 0) b.textContent = cap(weekdayLong.format(asDate(all[j].date)));
        b.addEventListener('click', () => show(j));
      });

      function show(j: number) {
        buttons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === j)));
        const d = all[j];
        const valley = groups.valle[j];
        const top = groups.cumbre[j];
        const highProb = Math.max(top.precipProb, groups.alta[j].precipProb);
        const today = j === 0 && nowTemp != null;
        const valleyCode = today ? nowCode : valley.code;

        root.dataset.sky = skyFor(valleyCode, today ? isDay : true);
        // «miércoles, 4 de noviembre» → «Miércoles 4 de noviembre»
        $('[data-date]').textContent = cap(longDate.format(asDate(d.date)).replace(',', ''));
        $('[data-phrase]').textContent = phrase(valleyCode, top, highProb);

        $('[data-k-valley-label]').textContent = today ? 'Valles · ahora' : 'Valles · máx.';
        $('[data-k-valley]').textContent = deg(today ? nowTemp! : valley.tMax);
        $('[data-k-summit]').textContent = deg(top.tMax);
        $('[data-k-iso]').textContent = meters(d.freezingLevel);
        if (top.snow >= SNOW_CM) {
          $('[data-k-extra-label]').textContent = 'Nieve en cumbres';
          $('[data-k-extra]').textContent = `${r(top.snow)} cm`;
        } else {
          $('[data-k-extra-label]').textContent = 'Viento en crestas';
          $('[data-k-extra]').textContent = `${r(top.gust)} km/h`;
        }

        // Línea de helada y neveros a su altura real
        const iso = d.freezingLevel ?? MAX_ALT;
        $<SVGGElement>('[data-iso]').style.transform = `translateY(${y(iso)}px)`;
        $<SVGRectElement>('[data-caps]').setAttribute('height', String(y(iso)));
        const label = $<SVGTextElement>('[data-iso-label]');
        label.textContent = `hiela por encima de ${meters(d.freezingLevel)}`;
        $<SVGRectElement>('[data-iso-pill]').setAttribute('width', String(label.getComputedTextLength() + 12));

        $('[data-desc]').textContent = `${cap(longDate.format(asDate(d.date)))}. ${phrase(valleyCode, top, highProb)} Hiela por encima de ${meters(d.freezingLevel)}.`;
      }

      show(0);
    } catch (err) {
      console.error(err);
      $('[data-phrase]').innerHTML =
        'No se ha podido cargar la previsión. Consulta <a href="https://www.aemet.es/es/eltiempo/prediccion/montana?w=&p=peu1">AEMET montaña</a>.';
    }
  }

  init();
</script>

<style>
  .hero {
    --sky: var(--sage);
    --mtn: var(--terracotta);
    --front: var(--brown);
    --ink: var(--brown);
    display: grid;
    gap: 16px;
    padding: 16px 0 8px;
  }
  /* Colores de cada cielo (sin texto encima salvo la etiqueta, que lleva fondo crema) */
  .hero[data-sky='partly'] { --sky: #92bf86; }
  .hero[data-sky='cloudy'] { --sky: #a9b7a0; --mtn: var(--terracotta-dark); }
  .hero[data-sky='fog'] { --sky: #c9c3ad; --mtn: #b46a4a; }
  .hero[data-sky='rain'] { --sky: #8fa39a; --mtn: var(--terracotta-dark); }
  .hero[data-sky='snow'] { --sky: #a9b7b0; --mtn: var(--olive); }
  .hero[data-sky='storm'] { --sky: #5d6a63; --mtn: #a8401b; }
  .hero[data-sky='night'],
  .hero[data-sky='night-cloudy'] { --sky: #2f3a3a; --mtn: #7a3a1e; --front: #1e1410; --ink: var(--cream); }
  .hero[data-sky='night-cloudy'] { --sky: #3a4242; }

  .art {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .sky-bg { fill: var(--sky); transition: fill 0.6s; }
  .mtn { fill: var(--mtn); transition: fill 0.6s; }
  .front { fill: var(--front); transition: fill 0.6s; }
  .caps { fill: var(--cream); transition: height 0.6s ease; }
  .sun { fill: var(--mustard); }
  .moon { fill: var(--mustard); }
  .moon circle { fill: var(--cream); }
  .cloud { fill: var(--cream); }
  .rain line { stroke: var(--cream); stroke-width: 2.4; stroke-linecap: round; }
  .flakes { fill: var(--cream); }
  .bolt { fill: var(--mustard); }
  .fog rect { fill: var(--cream); opacity: 0.7; }

  /* Qué se ve en cada cielo */
  .sun, .moon, .cloud, .cloud-2, .rain, .flakes, .bolt, .fog { display: none; }
  .hero[data-sky='clear'] .sun,
  .hero[data-sky='partly'] .sun,
  .hero[data-sky='partly'] .cloud,
  .hero[data-sky='cloudy'] .cloud,
  .hero[data-sky='cloudy'] .cloud-2,
  .hero[data-sky='fog'] .fog,
  .hero[data-sky='rain'] .cloud,
  .hero[data-sky='rain'] .cloud-2,
  .hero[data-sky='rain'] .rain,
  .hero[data-sky='snow'] .cloud,
  .hero[data-sky='snow'] .flakes,
  .hero[data-sky='storm'] .cloud,
  .hero[data-sky='storm'] .cloud-2,
  .hero[data-sky='storm'] .rain,
  .hero[data-sky='storm'] .bolt,
  .hero[data-sky='night'] .moon,
  .hero[data-sky='night-cloudy'] .moon,
  .hero[data-sky='night-cloudy'] .cloud {
    display: inline;
  }

  .iso { transition: transform 0.6s ease; }
  .iso line { stroke: var(--ink); stroke-width: 1.6; stroke-dasharray: 6 4; }
  .pill { fill: var(--cream); }
  .iso text { fill: var(--brown); font: 600 10.5px var(--font); }

  .side {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .kicker {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .phrase {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.45rem, 5.5vw, 2rem);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -0.02em;
    min-height: 2.3em;
  }

  .keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
  }
  .key {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    min-height: 84px;
    padding: 10px 12px;
    border-radius: var(--radius);
    color: var(--brown);
  }
  .key dt {
    font-size: 0.8rem;
    font-weight: 600;
  }
  .key dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .k-valley { background: var(--mustard); }
  .k-summit { background: var(--terracotta-dark); color: #fff; }
  .k-iso { background: var(--sage); }
  .k-extra { background: var(--tan); }

  .days {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  .days button {
    padding: 9px 6px;
    border: 1.5px solid var(--text);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .days button[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }
  .cta {
    display: block;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .cta:hover {
    opacity: 0.9;
  }
  .credit {
    margin: 0;
    font-size: 0.72rem;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: 36px;
      padding-top: 40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky-bg, .mtn, .front, .caps, .iso { transition: none; }
  }
</style>
