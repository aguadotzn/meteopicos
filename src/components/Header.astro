---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/prevision`, label: 'Previsión' },
  { href: `${base}/mapa`, label: 'Mapa' },
  { href: `${base}/picos`, label: 'Picos' },
  { href: `${base}/esqui`, label: 'Esquí' },
  { href: `${base}/boletin`, label: 'Boletín' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
// Activo también en subpáginas (p. ej. /boletin/2026-11-03).
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={`${base}/`} aria-label="Meteo Picos de Europa, inicio">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M2 26 L11 11 L15 17 L21 7 L30 26 Z" fill="currentColor" />
        <path d="M18.6 11 L21 7 L23.4 11 L21.6 10 L20.4 11.2 Z" fill="var(--bg)" />
      </svg>
      <span class="name">Meteo Picos</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    min-height: 60px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    text-decoration: none;
  }
  .brand svg {
    color: var(--accent);
  }
  .name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  /* Subrayado editorial en lugar de pastilla */
  nav a {
    display: block;
    padding: 10px 10px 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }
  @media (max-width: 480px) {
    .bar {
      padding-top: 8px;
    }
    nav {
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 calc(var(--gutter) - 10px);
    }
    ul {
      justify-content: space-between;
    }
  }
</style>
