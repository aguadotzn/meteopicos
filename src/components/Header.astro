---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Previsión' },
  { href: `${base}/mapa`, label: 'Mapa' },
  { href: `${base}/picos`, label: 'Picos' },
  { href: `${base}/esqui`, label: 'Esquí' },
  { href: `${base}/boletin`, label: 'Boletín' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={`${base}/`}>
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M2 26 L11 10 L16 18 L21 8 L30 26 Z" fill="currentColor" />
      </svg>
      <span>Meteo Picos</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={current === l.href.replace(/\/$/, '') ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .brand svg {
    color: var(--accent);
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  nav a {
    display: block;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .bar {
      padding-top: 6px;
      padding-bottom: 6px;
    }
    nav {
      width: 100%;
    }
    ul {
      justify-content: space-between;
    }
  }
</style>
