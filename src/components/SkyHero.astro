---
// Portada: cielo según el tiempo real, crestas de los macizos con la isoterma de 0 °C
// y la temperatura por alturas. La cresta de datos tiene las cimas a su altitud real.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const W = 400;
const H = 270;
const TOP = 26;
const BOTTOM = 262;
const MAX_ALT = 2800;
const y = (alt: number) => BOTTOM - (alt / MAX_ALT) * (BOTTOM - TOP);

// [x, altitud]: Cornión, río Cares, Urrieles, río Duje, Ándara y descenso a los valles.
const profile: [number, number][] = [
  [0, 420], [12, 650], [24, 1100], [36, 1600], [46, 1950], [54, 2300], [62, 2596], [70, 2380],
  [78, 2200], [86, 1700], [94, 900], [100, 560],
  [108, 1100], [116, 1700], [126, 2200], [136, 2649], [144, 2450], [152, 2380], [158, 2518],
  [166, 2350], [174, 2450], [182, 2614], [190, 2300], [198, 1800], [206, 1200], [212, 950],
  [220, 1400], [228, 1950], [236, 2444], [246, 2150], [256, 1700], [266, 1150], [280, 700],
  [300, 450], [330, 340], [400, 300],
];
const ridge = profile.map(([x, a]) => `${x},${y(a).toFixed(1)}`).join(' L');
const silhouette = `M0,${H} L${ridge} L${W},${H} Z`;

const peaks = [
  { name: 'Peña Santa', x: 62, alt: 2596 },
  { name: 'Torre Cerredo', x: 136, alt: 2649 },
  { name: 'Lechugales', x: 232, alt: 2444 },
];

// Bandas de altitud; la cota media real de sus puntos se calcula en el cliente.
const bands = [
  { level: 'cumbre', label: 'Cumbres', alt: 2560 },
  { level: 'alta', label: 'Alta montaña', alt: 1750 },
  { level: 'media', label: 'Media montaña', alt: 1020 },
  { level: 'valle', label: 'Valles', alt: 350 },
];
const isoDefault = 2000;
---

<section class="hero" data-hero data-sky="cloudy" data-max-alt={MAX_ALT} data-top={TOP} data-bottom={BOTTOM} aria-labelledby="h-title">
  <div class="fx" aria-hidden="true"></div>

  <div class="container inner">
    <div class="text">
      <h1 id="h-title" class="title">El tiempo en Picos de Europa</h1>
      <p class="date" data-date>Hoy</p>
      <p class="big"><span data-big>—</span><span class="unit">°</span></p>
      <p class="cond" data-cond>Cargando la previsión…</p>
      <p class="line" data-line></p>
      <p class="summary" data-summary aria-live="polite"></p>
    </div>

    <figure class="figure">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="h-desc">
        <desc id="h-desc" data-desc>Perfil de los tres macizos con la isoterma de 0 °C y la temperatura por altitudes.</desc>
        <defs>
          <clipPath id="ridge-clip"><path d={silhouette} /></clipPath>
        </defs>
        <path d={silhouette} class="rock" />
        <g clip-path="url(#ridge-clip)">
          <rect x="0" y="0" width={W} height={y(isoDefault)} class="frost" data-frost />
        </g>
        <path d={`M${ridge}`} class="ridge" />

        {peaks.map((p) => (
          <text x={p.x} y={y(p.alt) - 7} class="peak-name" text-anchor="middle">{p.name}</text>
        ))}

        <g class="iso" data-iso style={`transform: translateY(${y(isoDefault)}px)`}>
          <line x1="0" x2={W} y1="0" y2="0" />
          <text x="4" y="-6" data-iso-label>0 °C</text>
        </g>

        {bands.map((b) => (
          <g class="band" data-band={b.level} style={`transform: translateY(${y(b.alt)}px)`}>
            <line x1="272" x2="296" y1="0" y2="0" />
            <text x="396" y="-6" class="band-label" text-anchor="end" data-band-label>{b.label}</text>
            <text x="396" y="12" class="band-temp" text-anchor="end" data-band-temp>—</text>
          </g>
        ))}
      </svg>
    </figure>
  </div>

  <svg class="front" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 48 L0 22 L30 14 L58 20 L92 6 L126 18 L160 10 L200 22 L236 12 L270 20 L310 8 L350 18 L400 12 L400 48 Z" class="mid" />
    <path d="M0 48 L0 34 L40 26 L80 32 L130 22 L180 30 L230 24 L280 32 L330 24 L400 30 L400 48 Z" class="near" />
  </svg>

  <div class="ground">
    <div class="container ground-inner">
      <div class="days" role="group" aria-label="Elegir día" data-days>
        {[0, 1, 2].map((i) => (
          <button type="button" class="day" data-day={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="wd">{i === 0 ? 'Hoy' : '—'}</span>
            <span class="ic" aria-hidden="true">·</span>
            <span class="t">—</span>
            <span class="iso0">0 °C a —</span>
          </button>
        ))}
      </div>
      <a class="cta" href={`${base}/prevision`}>Ver previsión por zonas <span aria-hidden="true">→</span></a>
      <p class="credit">Perfil esquemático con las cimas a su altitud real · Datos de Open-Meteo</p>
    </div>
  </div>
</section>

<script>
  import { points, type Level } from '../data/zones';
  import { getForecast, summarize, type Current, type Day } from '../lib/forecast';
  import { wmo } from '../lib/wmo';
  import { skyFor } from '../lib/sky';

  const root = document.querySelector<HTMLElement>('[data-hero]')!;
  const MAX_ALT = Number(root.dataset.maxAlt);
  const TOP = Number(root.dataset.top);
  const BOTTOM = Number(root.dataset.bottom);
  const y = (alt: number) => BOTTOM - (Math.min(alt, MAX_ALT) / MAX_ALT) * (BOTTOM - TOP);

  const m = new Intl.NumberFormat('es-ES', { useGrouping: 'always', maximumFractionDigits: 0 });
  const weekday = new Intl.DateTimeFormat('es-ES', { weekday: 'short', timeZone: 'UTC' });
  const longDate = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
  const r = Math.round;
  const asDate = (iso: string) => new Date(`${iso}T12:00:00Z`);
  const meters = (v: number | null) => (v == null ? '—' : `${m.format(r(v / 100) * 100)} m`);
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const avg = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;

  const levels: Level[] = ['cumbre', 'alta', 'media', 'valle'];
  const $ = <T extends Element>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;

  interface Group {
    level: Level;
    altitude: number;
    days: Day[];
  }

  function summary(g: Record<Level, Group>, j: number, freezing: number | null) {
    const top = g.cumbre.days[j];
    const high = Math.max(top.precipProb, g.alta.days[j].precipProb);
    const valley = g.valle.days[j];
    const parts: string[] = [];
    if (top.snow >= 0.5) parts.push(`Nieve en cumbres (${r(top.snow)} cm) por encima de ${meters(freezing)}.`);
    else if (high >= 50) parts.push(`Precipitación probable en altura (${high} %).`);
    else if (valley.precipProb >= 50) parts.push(`Lluvia probable en los valles (${valley.precipProb} %).`);
    if (top.gust >= 60) parts.push(`Rachas de ${r(top.gust)} km/h en crestas.`);
    return parts.join(' ');
  }

  async function init() {
    try {
      const forecast = await getForecast(points);
      const groups = Object.fromEntries(
        levels.map((level) => {
          const pf = forecast.points.filter((p) => p.point.level === level);
          const altitude = avg(pf.map((p) => p.point.altitude));
          // Media del grupo: más representativa de una franja de altitud que el peor caso.
          const days = pf[0].days.map((_, j) => {
            const ds = pf.map((p) => p.days[j]);
            return {
              ...ds[0],
              code: Math.max(...ds.map((d) => d.code)),
              tMax: avg(ds.map((d) => d.tMax)),
              tMin: avg(ds.map((d) => d.tMin)),
              precipProb: Math.max(...ds.map((d) => d.precipProb)),
              snow: Math.max(...ds.map((d) => d.snow)),
              gust: Math.max(...ds.map((d) => d.gust)),
            };
          });
          return [level, { level, altitude, days }];
        }),
      ) as Record<Level, Group>;
      const all = summarize(forecast.points);

      // Ahora mismo en los valles: temperatura media y el tiempo más frecuente.
      const now = forecast.points
        .filter((p) => p.point.level === 'valle')
        .map((p) => p.current)
        .filter((c): c is Current => c != null);
      const nowTemp = now.length ? avg(now.map((c) => c.temp)) : null;
      const codes = now.map((c) => c.code);
      const nowCode = codes.length
        ? codes.sort((a, b) => codes.filter((c) => c === b).length - codes.filter((c) => c === a).length)[0]
        : groups.valle.days[0].code;
      const isDay = now.length ? now.filter((c) => c.isDay).length >= now.length / 2 : true;

      for (const g of Object.values(groups)) {
        const band = $<SVGGElement>(`[data-band="${g.level}"]`);
        band.style.transform = `translateY(${y(g.altitude)}px)`;
        const label = $<SVGTextElement>('[data-band-label]', band);
        label.textContent = `${label.textContent} · ${m.format(r(g.altitude / 10) * 10)} m`;
      }

      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-day]')];
      buttons.forEach((b, j) => {
        const v = groups.valle.days[j];
        const w = wmo(v.code);
        $('.wd', b).textContent = j === 0 ? 'Hoy' : cap(weekday.format(asDate(all[j].date)));
        $('.ic', b).textContent = w.icon;
        $('.ic', b).setAttribute('title', w.label);
        $('.t', b).innerHTML = `<b>${r(v.tMax)}°</b>/${r(v.tMin)}°`;
        $('.iso0', b).textContent = `0 °C a ${meters(all[j].freezingLevel)}`;
        b.addEventListener('click', () => show(j));
      });

      function show(j: number) {
        buttons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === j)));
        const d = all[j];
        const valley = groups.valle.days[j];
        const today = j === 0 && nowTemp != null;
        const code = today ? nowCode : valley.code;
        root.dataset.sky = skyFor(code, today ? isDay : true);

        $('[data-date]').textContent = today
          ? `${cap(longDate.format(asDate(d.date)))} · ahora`
          : cap(longDate.format(asDate(d.date)));
        $('[data-big]').textContent = String(r(today ? nowTemp! : valley.tMax));
        $('[data-cond]').textContent = `${wmo(code).label} en los valles${today ? '' : ' · máxima'}`;
        $('[data-line]').textContent = `Cumbres ${r(groups.cumbre.days[j].tMax)}° · 0 °C a ${meters(d.freezingLevel)}`;
        $('[data-summary]').textContent = summary(groups, j, d.freezingLevel);

        const iso = d.freezingLevel ?? MAX_ALT;
        $<SVGGElement>('[data-iso]').style.transform = `translateY(${y(iso)}px)`;
        $<SVGRectElement>('[data-frost]').setAttribute('height', String(y(iso)));
        $('[data-iso-label]').textContent = `0 °C · ${meters(d.freezingLevel)}`;
        for (const g of Object.values(groups)) {
          const day = g.days[j];
          $(`[data-band="${g.level}"] [data-band-temp]`).textContent = `${r(day.tMax)}° / ${r(day.tMin)}°`;
        }
        $('[data-desc]').textContent =
          `${cap(longDate.format(asDate(d.date)))}: isoterma de 0 °C a ${meters(d.freezingLevel)}. ` +
          levels.map((l) => `${l}: ${r(groups[l].days[j].tMax)}° de máxima`).join(', ') + '.';
      }

      show(0);
    } catch (err) {
      console.error(err);
      $('[data-cond]').innerHTML =
        'No se ha podido cargar la previsión. Consulta <a href="https://www.aemet.es/es/eltiempo/prediccion/montana?w=&p=peu1">AEMET montaña</a>.';
    }
  }

  init();
</script>

<style>
  /* Registradas para que el cambio de cielo se anime */
  @property --sky-top {
    syntax: '<color>';
    inherits: true;
    initial-value: #4a5c6e;
  }
  @property --sky-bottom {
    syntax: '<color>';
    inherits: true;
    initial-value: #687889;
  }
  @property --ground {
    syntax: '<color>';
    inherits: true;
    initial-value: #2b3a48;
  }
  /* Cada cielo define sus colores. Todos mantienen contraste ≥ 4,5:1 con texto blanco. */
  .hero {
    --sky-top: #4f6274;
    --sky-bottom: #687889;
    --ground: #2b3a48;
    position: relative;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 100%);
    transition: --sky-top 0.8s, --sky-bottom 0.8s, --ground 0.8s;
    padding-top: 116px; /* hueco para la cabecera transparente (en móvil, logo + menú) */
  }
  .hero[data-sky='clear'] { --sky-top: #1f63a8; --sky-bottom: #3a7ab8; --ground: #1d4a74; }
  .hero[data-sky='partly'] { --sky-top: #2f6596; --sky-bottom: #497aa6; --ground: #24496c; }
  .hero[data-sky='cloudy'] { --sky-top: #4a5c6e; --sky-bottom: #687889; --ground: #2b3a48; }
  .hero[data-sky='fog'] { --sky-top: #55606b; --sky-bottom: #6d7781; --ground: #3a444e; }
  .hero[data-sky='rain'] { --sky-top: #33444f; --sky-bottom: #687885; --ground: #243039; }
  .hero[data-sky='snow'] { --sky-top: #435a72; --sky-bottom: #63788d; --ground: #2c3f53; }
  .hero[data-sky='storm'] { --sky-top: #1f2734; --sky-bottom: #586577; --ground: #161c25; }
  .hero[data-sky='night'] { --sky-top: #0a1424; --sky-bottom: #25385a; --ground: #0b1320; }
  .hero[data-sky='night-cloudy'] { --sky-top: #141b26; --sky-bottom: #36404f; --ground: #10151d; }

  /* Lluvia y nieve: capas animadas muy suaves */
  .fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s;
  }
  .hero[data-sky='rain'] .fx,
  .hero[data-sky='storm'] .fx {
    opacity: 0.35;
    background-image: repeating-linear-gradient(105deg, transparent 0 14px, rgb(255 255 255 / 0.5) 14px 15px);
    background-size: 100% 120px;
    animation: fall 0.6s linear infinite;
  }
  .hero[data-sky='snow'] .fx {
    opacity: 0.8;
    background-image:
      radial-gradient(circle, #fff 1.4px, transparent 1.6px),
      radial-gradient(circle, rgb(255 255 255 / 0.7) 1px, transparent 1.2px);
    background-size: 46px 46px, 28px 28px;
    background-position: 0 0, 13px 7px;
    animation: snow 9s linear infinite;
  }
  @keyframes fall {
    to { background-position: 0 120px; }
  }
  @keyframes snow {
    to { background-position: 30px 460px, 50px 280px; }
  }

  .inner {
    position: relative;
    display: grid;
    gap: 8px;
  }
  .text p {
    margin: 0;
  }
  .title {
    margin: 0 0 2px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.9;
  }
  .date {
    font-size: 0.95rem;
    opacity: 0.9;
  }
  .big {
    font-size: clamp(5rem, 24vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 4px 0 !important;
  }
  .unit {
    font-weight: 400;
  }
  .cond {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .line {
    font-size: 1rem;
    margin-top: 4px !important;
  }
  .summary {
    font-size: 0.95rem;
    opacity: 0.92;
    margin-top: 6px !important;
    max-width: 44ch;
    min-height: 1.4em;
  }
  .text :global(a) {
    color: #fff;
  }

  .figure {
    margin: 4px calc(-1 * var(--gutter)) 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .rock {
    fill: rgb(255 255 255 / 0.22);
  }
  .frost {
    fill: rgb(255 255 255 / 0.5);
    transition: height 0.6s ease;
  }
  .ridge {
    fill: none;
    stroke: rgb(255 255 255 / 0.75);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .peak-name {
    fill: #fff;
    font: 600 9.5px var(--font);
  }
  .iso {
    transition: transform 0.6s ease;
  }
  .iso line {
    stroke: #fff;
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }
  .iso text {
    fill: #fff;
    font: 700 12px var(--font);
  }
  .band line {
    stroke: rgb(255 255 255 / 0.7);
    stroke-width: 1;
  }
  .band-label {
    fill: #fff;
    font: 500 10.5px var(--font);
  }
  .band-temp {
    fill: #fff;
    font: 700 15px var(--font);
  }
  /* Sombra suave bajo las etiquetas para que se lean sobre cualquier cielo */
  .peak-name,
  .iso text,
  .band-label,
  .band-temp {
    paint-order: stroke;
    stroke: rgb(0 0 0 / 0.35);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .front {
    display: block;
    width: 100%;
    height: 48px;
    margin-top: -40px;
    position: relative;
  }
  .front .mid {
    fill: color-mix(in srgb, var(--ground) 60%, transparent);
  }
  .front .near {
    fill: var(--ground);
  }
  .ground {
    position: relative;
    background: var(--ground);
    padding: 4px 0 28px;
  }
  .ground-inner {
    display: grid;
    gap: 14px;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .day {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 10px 6px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .day[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.18);
    border-color: #fff;
  }
  .day .wd {
    font-weight: 700;
  }
  .day .ic {
    font-size: 1.5rem;
    line-height: 1.3;
  }
  .day .iso0 {
    font-size: 0.75rem;
    opacity: 0.85;
  }
  .cta {
    justify-self: start;
    padding: 13px 22px;
    border-radius: 999px;
    background: #fff;
    color: var(--ground);
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover {
    background: #eef3f8;
  }
  .cta:focus-visible,
  .day:focus-visible {
    outline-color: #fff;
  }
  .credit {
    margin: 0;
    font-size: 0.72rem;
    opacity: 0.7;
  }

  @media (min-width: 481px) {
    .hero {
      padding-top: 84px;
    }
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 96px;
    }
    .inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: center;
      gap: 40px;
    }
    /* La cresta delantera solapa el final del hero: el texto queda por encima */
    .text {
      padding-bottom: 72px;
    }
    .figure {
      margin: 0;
    }
    .front {
      height: 70px;
      margin-top: -56px;
    }
    .ground-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .days {
      max-width: 520px;
    }
    .credit {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx {
      animation: none !important;
    }
    .frost,
    .iso,
    .hero {
      transition: none;
    }
  }
</style>
